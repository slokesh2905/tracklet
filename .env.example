# Copy to .env.local and fill in. Never commit real values.
# Tip: `vercel env pull` writes the Neon + Vercel values into .env.local for you.

# Database: Neon Postgres (pooled URL for the app, direct URL for migrations).
# For local dev, `npm run db:up` starts Postgres in Docker; point
# .env.development.local at postgres://tracklet:tracklet@localhost:5433/tracklet
DATABASE_URL=
DATABASE_URL_UNPOOLED=

# Better Auth. Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
BETTER_AUTH_SECRET=
# Optional social sign-in (magic-link email always works)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Firecrawl (https://firecrawl.dev → API keys)
FIRECRAWL_API_KEY=

# Email: set ONE provider. Gmail is free and needs no domain (~500 emails/day):
# enable 2-Step Verification, then create an app password at
# https://myaccount.google.com/apppasswords
GMAIL_USER=
GMAIL_APP_PASSWORD=
EMAIL_FROM_NAME=Tracklet
# ...or Resend (needs a verified domain to email anyone but yourself)
RESEND_API_KEY=
RESEND_FROM_EMAIL=

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Same generator as BETTER_AUTH_SECRET
CRON_SECRET=

# AI (optional; features are hidden when unset). Free option: an NVIDIA API key
# from https://build.nvidia.com (Nemotron via an OpenAI-compatible API).
NVIDIA_API_KEY=
# ...or Vercel AI Gateway (the Vercel team needs a card on file)
AI_GATEWAY_API_KEY=
# Optional model override, e.g. nvidia/nemotron-3-super-120b-a12b
AI_MODEL=
AI_DAILY_LIMIT=20
