# Copy to .env.local and fill in. Never commit real values.

# Supabase (Project settings → API). For local dev use `npx supabase status`.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Firecrawl (https://firecrawl.dev → API keys)
FIRECRAWL_API_KEY=

# Resend (https://resend.com). onboarding@resend.dev only delivers to your own address.
RESEND_API_KEY=
RESEND_FROM_EMAIL=Tracklet <onboarding@resend.dev>

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
CRON_SECRET=

# AI (optional). Locally: an AI Gateway key. On Vercel, OIDC is used automatically.
AI_GATEWAY_API_KEY=
AI_MODEL=anthropic/claude-haiku-4.5
AI_DAILY_LIMIT=20
